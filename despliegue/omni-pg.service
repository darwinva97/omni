[Unit]
Description=Omni — clúster de Postgres propio (puerto 5440)
# No toca el Postgres del sistema: es un clúster aparte, con sus datos en
# ~/.local/omni-pg y su propio puerto.
After=network.target

[Service]
Type=forking
ExecStart=/home/maka/projects/omni/scripts/local-postgres.sh start
ExecStop=/home/maka/projects/omni/scripts/local-postgres.sh stop
# `pg_ctl start` sale cuando el servidor acepta conexiones, así que cuando
# systemd considera esta unidad arrancada la base ya responde de verdad.
RemainAfterExit=no
TimeoutStartSec=120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

[Unit]
Description=Omni — despliegue continuo de main con CI en verde
# Lo lanza omni-cd.timer cada minuto; lo que hace está en scripts/cd.sh.

[Service]
Type=oneshot
WorkingDirectory=/home/maka/projects/omni
# pnpm vive en ~/.local/bin, que no está en el PATH de los servicios.
Environment=PATH=/home/maka/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/maka/projects/omni/scripts/cd.sh
# Un build del panel tarda en torno a un minuto; un despliegue con vuelta
# atrás, el doble. Esto es para que uno colgado no bloquee los siguientes.
TimeoutStartSec=20min
StandardOutput=append:/home/maka/projects/omni/.data/cd.log
StandardError=append:/home/maka/projects/omni/.data/cd.log

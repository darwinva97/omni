# Base de datos
DATABASE_URL=postgres://omni@127.0.0.1:5440/omni_dev

# Cifra las credenciales de TODAS las líneas: 64 caracteres hex, o una frase de
# 32 o más. PERDERLA SIGNIFICA PERDER TODAS LAS SESIONES.
OMNI_MASTER_KEY=

# Presente → colas y bus sobre Redis. Ausente → todo sobre Postgres.
# REDIS_URL=redis://127.0.0.1:6379

PORT=4000
PUBLIC_URL=http://127.0.0.1:4000
SANDBOX_ENABLED=true
BILLING_ENABLED=false
LOG_LEVEL=info

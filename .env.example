# Base de datos
DATABASE_URL=postgres://omni@127.0.0.1:5440/omni_dev

# Cifra las credenciales de TODAS las líneas: 64 caracteres hex, o una frase de
# 32 o más. PERDERLA SIGNIFICA PERDER TODAS LAS SESIONES.
OMNI_MASTER_KEY=

# Presente → colas y bus sobre Redis. Ausente → todo sobre Postgres.
# REDIS_URL=redis://127.0.0.1:6379

PORT=4000
PUBLIC_URL=http://127.0.0.1:4000
SANDBOX_ENABLED=true
BILLING_ENABLED=false
LOG_LEVEL=info

# Almacén de medios. Sin S3_BUCKET se usa el disco, en un directorio propio que
# NO debe estar bajo ninguna carpeta servida estáticamente.
MEDIA_DIR=./.data/media
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Servidor MCP. Apagado por defecto y de solo lectura si se enciende.
MCP_ENABLED=false
MCP_READONLY=true

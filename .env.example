# Base de datos
DATABASE_URL=postgres://omni@127.0.0.1:5440/omni_dev

# Cifra las credenciales de TODAS las líneas: 64 caracteres hex, o una frase de
# 32 o más. PERDERLA SIGNIFICA PERDER TODAS LAS SESIONES.
OMNI_MASTER_KEY=

# Presente → colas y bus sobre Redis. Ausente → todo sobre Postgres.
# REDIS_URL=redis://127.0.0.1:6379

PORT=4010
PUBLIC_URL=http://127.0.0.1:4010
SANDBOX_ENABLED=true
BILLING_ENABLED=false
LOG_LEVEL=info

# Almacén de medios. Sin S3_BUCKET se usa el disco, en un directorio propio que
# NO debe estar bajo ninguna carpeta servida estáticamente.
MEDIA_DIR=./.data/media
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Servidor MCP. Apagado por defecto y de solo lectura si se enciende.
MCP_ENABLED=false
MCP_READONLY=true

# Ejecutar los trabajadores dentro de la API. Cómodo para un solo proceso; con
# tráfico conviene apagarlo y levantar @omni/worker aparte.
RUN_WORKERS_IN_API=true

# Transporte Baileys (cliente NO oficial de WhatsApp: ver el aviso del README).
WHATSAPP_BAILEYS_ENABLED=true

# Transporte oficial de Meta. Sin sockets ni coste por línea; las credenciales
# van en el driverConfig de cada línea, no aquí.
WHATSAPP_CLOUD_ENABLED=true

# Transporte por navegador (whatsapp-web.js). Menor riesgo de baneo que Baileys,
# a cambio de ~400 MB por línea. Apagado por defecto a propósito.
WHATSAPP_WEB_ENABLED=false
# CHROMIUM_PATH=/usr/bin/chromium
